{
	// Orbit, night. Saving this file restyles every open window in place.
	//
	// A deep night sky: blue-black neutrals, cool starlight for text, and
	// depth from light rather than lines (what is nearer is a little
	// brighter, its edge catches light along the top). One luminous accent
	// per agent (kx.agent.*), and one warm colour, kx.attention, spent only
	// on what needs you.
	"name": "orbit-night",
	"type": "dark",
	"extends": "zgx-dark",
	"tokens": {
		// The window: a deep scrim over the system backdrop (Mica).
		"background": "#06080ed6",
		"glass.tint": "#06080ed6",
		"glass.blur": 28,
		"surface": {
			"sunken": "#02030799",
			"base": "#b8c6ff08",
			"raised": "#b8c6ff0f",
			"overlay": "#0c1020ec"
		},
		"popover.bg": "#151a2b",
		"text": {
			// Starlight: a cool white. Muted text is the same light, dimmer,
			// so it takes the colour of whatever it sits on.
			"primary": "#e7ebf5",
			"secondary": "alpha({text.primary}, 0.64)",
			"tertiary": "alpha({text.primary}, 0.42)",
			"disabled": "alpha({text.primary}, 0.26)"
		},
		"border": "#b8c6ff16",
		"border.subtle": "#b8c6ff0b",
		"border.strong": "#b8c6ff30",
		// Kepler's blue: the app's own light, before any agent's.
		"accent": "#86a8ff",
		"accent.hover": "#9ab7ff",
		"accent.text": "#060914",
		"danger": "#ff8189",
		"warning": "#f2c86b",
		"success": "#6fd6ad",
		"info": "#86a8ff",
		// One wash for hover, press and selection: light laid over light.
		"hover": "#c8d4ff0d",
		"pressed": "#c8d4ff18",
		"selection": "#86a8ff40",
		"selection.item": "#c8d4ff14",
		"focus.ring": "alpha({accent}, 0.7)",
		"scrollbar": {
			"track": "#00000000",
			"thumb": "alpha({text.primary}, 0.18)",
			"thumb.active": "alpha({text.primary}, 0.36)"
		},
		"font": {
			"sans": "Inter",
			"mono": "JetBrains Mono",
			"size": { "xs": 11, "sm": 12.5, "md": 13.5, "lg": 15, "xl": 19, "xxl": 26 },
			"line": { "xs": 16, "sm": 18, "md": 21, "lg": 23, "xl": 26, "xxl": 32 }
		},
		// The lens family: soft, never pill-like except where a pill is meant.
		"radius": { "sm": 6, "md": 9, "lg": 13, "xl": 18 },
		"control.height": 32,
		"shadow": {
			"sm": "0 1 2 0 #00000066",
			"md": "0 6 18 -4 #0000008c",
			"lg": "0 18 48 -12 #000000b3"
		},
		"motion": {
			"duration": { "fast": 140, "normal": 220, "slow": 360 },
			"ease": {
				// Orbit's one curve: eases in, overshoots a breath, settles.
				"standard": "cubicBezier(0.22, 1.12, 0.36, 1)",
				"enter": "cubicBezier(0.16, 1.18, 0.3, 1)",
				"exit": "cubicBezier(0.4, 0, 0.8, 0.4)"
			}
		},
		"kx": {
			"display": "Inter Display",
			"solid": "#080b14",
			// The warm colour, reserved for "this needs you".
			"attention": "#ffb366",
			"attention.soft": "alpha({kx.attention}, 0.16)",
			// The lip of light along a lifted surface's top edge.
			"lip": "#dfe6ff24",
			"lip.strong": "#dfe6ff3d",
			// The night behind it all, for the intro and Constellation.
			"sky": { "deep": "#03040a", "mid": "#0a1024", "glow": "#1a2550" }
		}
	}
}
