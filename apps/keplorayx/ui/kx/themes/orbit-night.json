{
	// Orbit, night. Saving this file restyles every open window in place.
	//
	// Charcoal glass, as Zeron's dark is (its values, credited in
	// THIRD_PARTY_NOTICES.md): depth reads by light, not shadow. What is
	// nearer is lighter, its edge a faint even hairline; shadows sit under it
	// soft, felt more than seen. The window is a deep scrim over the
	// system's blur, letting the desktop's colour through. Keplorayx's own
	// light is a dusty starlight blue, spent sparingly; the one warm colour,
	// kx.attention, is spent only on what needs you.
	"name": "orbit-night",
	"type": "dark",
	"extends": "zgx-dark",
	"tokens": {
		"background": "#0b0b0dcc",
		"glass.tint": "#0b0b0dcc",
		"glass.blur": 28,
		"popover.bg": "#2a2a2f",
		"surface": {
			"sunken": "#000000c2",
			"base": "#ffffff08",
			"raised": "#ffffff0f",
			"overlay": "#1b1b1ee0"
		},
		"text": {
			// Muted text is the primary at less opacity, not a grey: it takes
			// the colour of whatever is behind it.
			"primary": "#ededef",
			"secondary": "alpha({text.primary}, 0.6)",
			"tertiary": "alpha({text.primary}, 0.42)",
			"disabled": "alpha({text.primary}, 0.28)"
		},
		"border": "#ffffff12",
		"border.subtle": "#ffffff0a",
		"border.strong": "#ffffff2e",
		// Kepler: starlight blue, dusty on dark glass (a saturated blue there
		// reads as a link).
		"accent": "#7f97c9",
		"accent.hover": "#8ea4d2",
		"accent.text": "#ffffff",
		"danger": "#f87171",
		"warning": "#facc15",
		"success": "#34d399",
		"info": "#60a5fa",
		// One wash for hover, press and selection: a breath of light.
		"hover": "#ffffff0d",
		"pressed": "#ffffff17",
		"selection": "alpha({accent}, 0.32)",
		"selection.item": "#ffffff1a",
		"backdrop": "#00000059",
		"focus.ring": "alpha({accent}, 0.6)",
		"scrollbar": {
			"track": "#00000000",
			"thumb": "alpha({text.primary}, 0.26)",
			"thumb.active": "alpha({text.primary}, 0.44)"
		},
		"font": {
			"sans": "Geist",
			"mono": "Geist Mono",
			"size": { "xs": 11, "sm": 12, "md": 13, "lg": 15, "xl": 20, "xxl": 28 },
			"line": { "xs": 14, "sm": 16, "md": 18, "lg": 20, "xl": 26, "xxl": 34 }
		},
		"space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
		"radius": { "sm": 4, "md": 6, "lg": 8, "xl": 12 },
		"control.height": 32,
		"shadow": {
			"sm": "0 1 2 0 #00000059",
			"md": "0 4 12 0 #00000066",
			"lg": "0 12 32 0 #00000080"
		},
		"motion": {
			"duration": { "fast": 120, "normal": 180, "slow": 240 },
			"ease": {
				"standard": "cubicBezier(0.2, 0, 0, 1)",
				"enter": "cubicBezier(0.16, 1, 0.3, 1)",
				"exit": "cubicBezier(0.4, 0, 1, 1)"
			}
		},
		"kx": {
			"display": "Instrument Serif",
			"solid": "#0e0e10",
			"attention": "#f5b45f",
			"glow.attention": "0 0 12 0 alpha({kx.attention}, 0.4)",
			"attention.soft": "alpha({kx.attention}, 0.14)",
			// A raised thing's edge: even all round, no light along its top.
			"lip": "#ffffff0d",
			"lip.strong": "#ffffff1f",
			"lift": "0 1 3 0 #00000066",
			"well": { "edge": "#ffffff17" },
			// A primary button: the lightest thing on the glass.
			"primary": { "bg": "#ededef", "hover": "#ffffff", "text": "#0e0e10" },
			"secondary": { "bg": "#ffffff14", "hover": "#ffffff1f" },
			// The lines of a tree (a project's threads, a turn's tools).
			"tree": "alpha({text.primary}, 0.16)",
			// An agent's status: a hue a state, light steps on the dark.
			"status": {
				"working": "{text.secondary}",
				"input": "#818cf8",
				"approval": "#fbbf24",
				"done": "#34d399",
				"failed": "#f87171",
				"idle": "#9ca3af"
			},
			// Code: pale steps of one perceived lightness, so no hue shouts on
			// dark glass (Zeron's syntax palette).
			"syntax": {
				"keyword": "#c4b5fd", "function": "#93c5fd", "type": "#fcd34d",
				"string": "#86efac", "escape": "#67e8f9", "regex": "#5eead4",
				"number": "#fdba74", "constant": "#fdba74", "macro": "#f0abfc",
				"property": "#fecdd3", "variable": "#f9a8d4", "attribute": "#fde047",
				"label": "#a5b4fc", "tag": "#fca5a5", "heading": "#c4b5fd", "link": "#93c5fd",
				"emphasis": "#f9a8d4", "strong": "#fed7aa",
				"inserted": "#4ade80", "deleted": "#f87171", "hunk": "#c4b5fd"
			},
			"git": { "modified": "#fbbf24", "added": "#4ade80", "untracked": "#34d399", "deleted": "#f87171" },
			"sky": { "deep": "#050506", "mid": "#0e0e12", "glow": "#2a3350" }
		}
	}
}
