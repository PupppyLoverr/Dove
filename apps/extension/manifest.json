{
  "manifest_version": 3,
  "name": "Dove for Chrome",
  "short_name": "Dove",
  "version": "0.2.0",
  "description": "Lets the agents in your Dove app work in this browser, with your logins, on the sites you allow. You review anything that submits, buys, sends or deletes.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "storage",
    "sidePanel",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Dove",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
