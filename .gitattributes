# Skill files are embedded into the binary (include_str!) and checked for
# YAML frontmatter that starts with a "---" line ending in LF: keep them LF
# on every checkout, Windows (core.autocrlf) included.
skills/** text eol=lf
# Binaries in skill folders (eval screenshots, assets) are never converted.
skills/**/*.png binary
skills/**/*.jpg binary
skills/**/*.jpeg binary
skills/**/*.gif binary
skills/**/*.webp binary
skills/**/*.pdf binary
# The Local Grounder's network, built into Dove.
crates/dove-grounder/assets/*.onnx binary
crates/dove-grounder/tests/goldens/*.gz binary
# The computer tool's frozen schema is compared byte for byte.
crates/dove-computer/tests/golden/*.json text eol=lf
